        }
    }
    
    public function loadBalances()
    {
        $this->balances = $this->getBalancesData();
        $this->calculateStats();
    }
    
    private function getBalancesData()
    {
        $cacheKey = "balance_data_{$this->entreprise->id}_{$this->type}_{$this->dateDebut}_{$this->dateFin}_{$this->exercice}_{$this->accountId}_{$this->search}";
        
        return Cache::remember($cacheKey, 300, function () {
            // Récupérer les comptes SYCEBNL qui ont des mappings
            $accounts = NewAccount::where('entreprise_id', $this->entreprise->id)
                ->whereHas('mappings')
                ->when($this->accountId, function ($query) {
                    $query->where('id', $this->accountId);
                })
                ->when($this->search, function ($query) {
                    $query->where(function ($q) {
                        $q->where('code', 'like', '%' . $this->search . '%')
                          ->orWhere('intitule', 'like', '%' . $this->search . '%');
                    });
                })
                ->orderBy('code')
                ->get();
            
            $balances = [];
            
            foreach ($accounts as $account) {
                // Récupérer les anciens comptes mappés à ce compte SYCEBNL
                $oldAccountIds = AccountMapping::where('new_account_id', $account->id)
                    ->where('entreprise_id', $this->entreprise->id)
                    ->pluck('old_account_id')
                    ->toArray();
                
                if (empty($oldAccountIds)) {
                    continue; // On ne garde que les comptes qui ont des mappings
                }
                
                // Récupérer toutes les écritures des anciens comptes mappés DANS LA PÉRIODE
                $ecrituresQuery = GrandLivre::with(['oldAccount'])
                    ->forEntreprise($this->entreprise->id)
                    ->whereIn('old_account_id', $oldAccountIds);
                
                // Appliquer les filtres de période
                if ($this->dateDebut && $this->dateFin) {
                    $ecrituresQuery->whereBetween('date_ecriture', [$this->dateDebut, $this->dateFin]);
                }
                
                if ($this->exercice) {
                    $ecrituresQuery->where('exercice', $this->exercice);
                }
                
                $ecritures = $ecrituresQuery->valides()->get();
                
                // Ajouter les écritures directes sur le nouveau compte (si elles existent)
                $directEcrituresQuery = GrandLivre::forEntreprise($this->entreprise->id)
                    ->where('new_account_id', $account->id);
                
                if ($this->dateDebut && $this->dateFin) {
                    $directEcrituresQuery->whereBetween('date_ecriture', [$this->dateDebut, $this->dateFin]);
                }
                
                if ($this->exercice) {
                    $directEcrituresQuery->where('exercice', $this->exercice);
                }
                
                $directEcritures = $directEcrituresQuery->valides()->get();
                
                // Fusionner toutes les écritures
                $allEcritures = $ecritures->merge($directEcritures);
                
                // Si pas d'écritures dans la période, on peut quand même afficher le compte avec des totaux à 0
                // OU on peut le sauter si vous préférez ne montrer que ceux avec des mouvements
                
                // Calculer les totaux (même si 0)
                $totalDebit = $allEcritures->sum('debit');
                $totalCredit = $allEcritures->sum('credit');
                $solde = $totalDebit - $totalCredit;
                
                // Calculer les soldes N-1
                $soldeN1 = $this->getNewAccountSoldeN1($account->id);
                
                // Détails par ancien compte
                $oldAccountsDetails = [];
                foreach ($oldAccountIds as $oldId) {
                    $oldEcritures = $allEcritures->where('old_account_id', $oldId);
                    
                    // Même si pas d'écritures, on garde le compte pour information
                    $oldAccount = OldAccount::find($oldId);
                    if ($oldAccount) {
                        // Calculer les soldes N-1 pour chaque ancien compte
                        $oldSoldeN1 = $this->getOldAccountSoldeN1($oldId);
                        
                        $oldAccountsDetails[] = [
                            'id' => $oldId,
                            'code' => $oldAccount->code ?? 'N/A',
                            'intitule' => $oldAccount->intitule ?? 'N/A',
                            'debit' => $oldEcritures->sum('debit'),
                            'credit' => $oldEcritures->sum('credit'),
                            'count' => $oldEcritures->count(),
                            'solde_debit_n1' => $oldSoldeN1['debit'],
                            'solde_credit_n1' => $oldSoldeN1['credit'],
                        ];
                    }
                }
                
                // AJOUTEZ CETTE OPTION : Afficher même les comptes sans écritures dans la période
                // Si vous voulez voir tous les comptes mappés, même sans mouvement
                $balances[] = [
                    'id' => $account->id,
                    'code' => $account->code,
                    'intitule' => $account->intitule,
                    'classe' => $account->classe,
                    'groupe' => $account->groupe,
                    'niveau' => $account->niveau,
                    'type' => 'new',
                    'solde_debit_n1' => $soldeN1['debit'],
                    'solde_credit_n1' => $soldeN1['credit'],
                    'total_debit' => $totalDebit,
                    'total_credit' => $totalCredit,
                    'solde' => $solde,
                    'ecritures_count' => $allEcritures->count(),
                    'old_accounts' => $oldAccountsDetails,
                    'old_accounts_count' => count($oldAccountsDetails),
                    'ecritures' => $allEcritures,
                    'account' => $account,
                    'has_movements' => $allEcritures->count() > 0, // Nouveau champ pour filtrage
                ];
            }
            
            // OPTIONNEL : Filtrer pour ne garder que les comptes avec des mouvements
            // $balances = array_filter($balances, function($balance) {
            //     return $balance['has_movements'];
            // });
            
            // Trier
            $this->sortBalances($balances);
            return $balances;
        });
    }
    
